          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona varias imágenes para convertirlas juntas en un solo PDF. Reordénalas desde \"Editar\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
